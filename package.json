{
  "name": "ditch",
  "version": "0.1.0",
  "description": "Web-server live-stream-downloader: detect and download streams to server-local storage.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && cp -r src/public dist/public",
    "typecheck": "tsc --noEmit",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --test --test-force-exit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "m3u8-parser": "^7.2.0",
    "mpd-parser": "^1.3.1",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/m3u8-parser": "^7.2.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
